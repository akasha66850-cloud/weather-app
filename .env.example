# Django Configuration
DJANGO_SECRET_KEY=django-insecure-weather-app-secret-key-2024
DEBUG=True

# OpenWeather API Key
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google OAuth (leave empty to hide Google Sign-In button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Settings (Defaults to console backend in DEBUG=True)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Twilio SMS Configuration (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
